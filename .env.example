# CenLearn — Live Server Environment Variables
# Copy this file to the directory THREE levels above /system (outside webroot)
# and name it .cenlearn.env, then fill in your real credentials.
#
# Example path: /home/u520834156/.cenlearn.env
#
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
