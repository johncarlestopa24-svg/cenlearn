# CenLearn Online Production Apache Handler — Pretty Extensionless URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex index.php

    # 1. Strip .php extension safely
    RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 2. Allow existing static assets and directories to load directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Internal rewrite extensionless requests to .php file
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [QSA,L]
</IfModule>
