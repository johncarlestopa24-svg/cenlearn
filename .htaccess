# CenLearn Local Apache Root Rewrite Handler
<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex index.php

    # 1. Do not rewrite existing files or directories in root
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Allow extensionless URLs (e.g. /student/dashboard -> system/student/dashboard.php)
    RewriteCond %{DOCUMENT_ROOT}/system/$1.php -f
    RewriteRule ^(.*)$ system/$1.php [L]

    # 3. Rewrite all remaining page and asset requests seamlessly to system/
    RewriteRule ^(.*)$ system/$1 [L]
</IfModule>
