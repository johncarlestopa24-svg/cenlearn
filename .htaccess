# CenLearn Local Apache Root Handler
<IfModule mod_rewrite.c>
RewriteEngine On
DirectoryIndex index.php

# Allow URLs without .php extension (e.g. /teacher/dashboard -> /teacher/dashboard.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [QSA,L]
</IfModule>

<IfModule mod_negotiation.c>
Options +MultiViews
</IfModule>
