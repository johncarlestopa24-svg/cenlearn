# CenLearn Local Apache Handler — Pretty Extensionless URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex index.php

    # 1. Allow existing static files & directories in root to load directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Support extensionless PHP URLs inside system/ (e.g., /student/dashboard -> system/student/dashboard.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/cenlearn/system/$1.php -f
    RewriteRule ^(.*)$ system/$1.php [QSA,L]

    # 3. Support extensionless PHP URLs if file exists with .php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [QSA,L]

    # 4. Route remaining requests to system/ directory
    RewriteRule ^(.*)$ system/$1 [QSA,L]
</IfModule>
