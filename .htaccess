# CenLearn Local Apache Root Rewrite Handler
<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex index.php

    # Do not rewrite existing files or directories in root
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite asset and sub-page requests to system/ directory seamlessly
    RewriteRule ^(.*)$ system/$1 [L]
</IfModule>
